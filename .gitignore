target/
node_modules/
.mcp.json
dist/
/.pnpm-store/
/.turbo/
*.swp
*.swo
.DS_Store

# quickemu VM artifacts (Silverblue ISO + .qcow2 + logs)
tests/e2e/vm/
/*.iso
/*.qcow2

# Ubuntu LTS VM runtime artifacts (per-release subdirectories)
# overlay.qcow2, seed.iso, vm.pid, cloud-init/ are generated at runtime.
tests/e2e/ubuntu-vm/jammy/
tests/e2e/ubuntu-vm/noble/
tests/e2e/ubuntu-vm/resolute/

# E2E test logs (generated at runtime)
tests/e2e/logs/*.log
tests/e2e/exec/logs/*.log

# Cassette replay ledgers are per-run evidence, regenerated on every replay and
# truncated at its start. The cassettes themselves ARE committed: they are the
# fixture that lets the story suite run offline.
tests/e2e/cassettes/*.replay-log.jsonl

# mdBook build output
book/

# Local private docs (strategy, planning, personal notes — not for public repo)
docs/local/
/RELAUNCH_PLAN.md

# Python bytecode from packaging scripts (compiled when tests import them)
__pycache__/
*.pyc

# Local agent-tool artifacts. The codex CLI writes these into the working tree
# on every run: AGENTS.md as a byte-identical copy of CLAUDE.md (a duplicate that
# would drift immediately), and .codex/config.toml with absolute local paths.
# One of them reached a public commit via `git add -A`.
AGENTS.md
.codex/
