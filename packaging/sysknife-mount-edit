#!/usr/bin/env python3
# sysknife-mount-edit — mount/unmount a filesystem or enable/disable swap, and
# keep /etc/fstab in sync.
#
# Install to: /usr/lib/sysknife/mount-edit
# Mode:       0755
# Owner:      root:root
#
# Invoked exclusively by the sysknife-daemon via one of:
#   sudo /usr/lib/sysknife/mount-edit --op mount \
#        --device <dev|UUID=..|LABEL=..|//host/share|host:/export> \
#        --mountpoint <abs-path> --fstype <fs> [--options <csv>]
#   sudo /usr/lib/sysknife/mount-edit --op unmount   --mountpoint <abs-path>
#   sudo /usr/lib/sysknife/mount-edit --op addswap   --file <abs-path> --size-mb <n>
#   sudo /usr/lib/sysknife/mount-edit --op rmswap    --file <abs-path>
#
# Safety model (all inputs re-validated here — defense-in-depth):
#   - Every fstab entry SysKnife writes carries `nofail`, so a device that is
#     absent or wrong at boot can never wedge the boot (systemd skips it) —
#     this is the key guard against the classic "bad fstab bricks the box".
#   - mount: the fstab entry is appended FIRST, then `mount <mountpoint>` is run
#     (which reads fstab). If the mount fails the just-added line is rolled back
#     and the op fails — so a broken entry never persists.
#   - Critical system mountpoints (/, /boot, /etc, /usr, /var, /home, …) are
#     refused; SysKnife will not remount or shadow them.
#   - rmswap only unlinks a path the host already reports as a swap FILE, via
#     /proc/swaps or an /etc/fstab swap entry, and never a symlink. A charset
#     check alone made this a root arbitrary-deletion primitive: every step
#     before the unlink tolerates a non-swap path.
#   - fstype is an allowlist; device/mountpoint/options are charset-validated;
#     fstab is rewritten atomically (temp file + os.replace).

import argparse
import os
import re
import subprocess
import sys
import tempfile

FSTAB = "/etc/fstab"
PROC_SWAPS = "/proc/swaps"
MOUNT = "/usr/bin/mount"
UMOUNT = "/usr/bin/umount"
MKSWAP = "/usr/sbin/mkswap"
SWAPON = "/usr/sbin/swapon"
SWAPOFF = "/usr/sbin/swapoff"
DD = "/usr/bin/dd"

FSTYPE_ALLOW = {
    "ext4", "ext3", "ext2", "xfs", "btrfs", "vfat", "exfat",
    "ntfs3", "nfs", "nfs4", "cifs",
}
# Mountpoints SysKnife must never touch (remounting these can break the system).
CRITICAL_MOUNTPOINTS = {
    "/", "/boot", "/boot/efi", "/etc", "/usr", "/bin", "/sbin", "/lib",
    "/lib64", "/var", "/home", "/root", "/proc", "/sys", "/dev", "/run",
}

DEVICE_RE = re.compile(
    r"^(/dev/[A-Za-z0-9/_.-]+"
    r"|UUID=[0-9A-Fa-f-]{8,}"
    r"|LABEL=[A-Za-z0-9_.:-]+"
    r"|//[A-Za-z0-9._-]+/[A-Za-z0-9._/$-]+"          # cifs //host/share
    r"|[A-Za-z0-9._-]+:/[A-Za-z0-9._/-]*)$"           # nfs host:/export
)
MOUNTPOINT_RE = re.compile(r"^/[A-Za-z0-9/_.-]*$")
OPTIONS_RE = re.compile(r"^[A-Za-z0-9=,._:@/+-]*$")


def die(msg: str) -> None:
    print(f"sysknife-mount-edit: {msg}", file=sys.stderr)
    sys.exit(1)


def valid_mountpoint(mp: str) -> bool:
    return (
        bool(MOUNTPOINT_RE.match(mp))
        and ".." not in mp
        and mp not in CRITICAL_MOUNTPOINTS
        and mp != ""
    )


def assert_mountpoint_safe(mp: str) -> None:
    """Refuse a mountpoint whose resolved target is a critical/forbidden path, or
    that is reached through a symlink.

    A string-only check lets `/tmp/x -> /etc` mount an attacker share over /etc
    (#155), and `/etc/` or `//etc` slip past the literal denylist. Resolving the
    path with realpath and re-checking closes both. This is a fast pre-check with
    a clear error; it does NOT by itself close the TOCTOU window between the check
    and the later mount (op_mount does that with O_NOFOLLOW + /proc/self/fd).
    """
    real = os.path.realpath(mp)
    # A target that RESOLVES to a forbidden path is refused first, so /etc/,
    # //etc and symlinks into /etc all get an accurate, non-symlink message.
    if not valid_mountpoint(real):
        die(f"mountpoint {mp!r} resolves to {real!r}, which is invalid or forbidden")
    # A symlinked path (final component or an ancestor) to a non-critical target
    # is still attacker-controlled; refuse it.
    if os.path.islink(mp) or real != os.path.normpath(mp):
        die(f"mountpoint {mp!r} resolves to {real!r} through a symlink; refusing")


def read_fstab() -> list:
    if not os.path.exists(FSTAB):
        return []
    with open(FSTAB, "r") as fh:
        return fh.readlines()


def write_fstab(lines: list) -> None:
    directory = os.path.dirname(FSTAB)
    fd, tmp = tempfile.mkstemp(dir=directory, prefix=".sysknife-fstab-")
    try:
        with os.fdopen(fd, "w") as fh:
            fh.writelines(lines)
        os.chmod(tmp, 0o644)
        os.replace(tmp, FSTAB)
    except OSError as exc:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        die(f"cannot write {FSTAB}: {exc}")


def ensure_nofail(options: str) -> str:
    opts = [o for o in options.split(",") if o]
    if not opts:
        opts = ["defaults"]
    if "nofail" not in opts:
        opts.append("nofail")
    return ",".join(opts)


def fstab_field2(line: str) -> str:
    """Return the mountpoint (field 2) of an fstab line, or '' for comments."""
    stripped = line.strip()
    if not stripped or stripped.startswith("#"):
        return ""
    parts = stripped.split()
    return parts[1] if len(parts) >= 2 else ""


def fstab_field1(line: str) -> str:
    stripped = line.strip()
    if not stripped or stripped.startswith("#"):
        return ""
    parts = stripped.split()
    return parts[0] if len(parts) >= 1 else ""


def append_fstab_entry(lines: list, entry: str) -> list:
    """Return `lines` with `entry` appended, first appending a newline if the
    last existing line lacks one. Shared by op_mount and op_addswap."""
    return lines + ([] if (not lines or lines[-1].endswith("\n")) else ["\n"]) + [entry]


def remove_fstab_lines(lines: list, field_fn, value: str) -> list:
    """Return `lines` with rows where `field_fn(line) == value` dropped.
    Shared by op_unmount (field2/mountpoint) and op_rmswap (field1/device)."""
    return [ln for ln in lines if field_fn(ln) != value]


def op_mount(args) -> None:
    if not DEVICE_RE.match(args.device):
        die(f"invalid device {args.device!r}")
    if not valid_mountpoint(args.mountpoint):
        die(f"invalid or forbidden mountpoint {args.mountpoint!r}")
    if args.fstype not in FSTYPE_ALLOW:
        die(f"fstype {args.fstype!r} not in allowlist")
    options = args.options or "defaults"
    if not OPTIONS_RE.match(options):
        die(f"invalid options {options!r}")
    options = ensure_nofail(options)

    # Fast pre-check: reject a critical target or an already-symlinked mountpoint
    # with a clear message before doing any work.
    assert_mountpoint_safe(args.mountpoint)

    lines = read_fstab()
    # Refuse if this mountpoint already has an fstab entry.
    if any(fstab_field2(ln) == args.mountpoint for ln in lines):
        die(f"{args.mountpoint} already has an /etc/fstab entry")

    # Materialize the mountpoint as a real directory and hold a fd to that exact
    # inode. O_DIRECTORY|O_NOFOLLOW rejects a symlink swapped in for the leaf
    # after the pre-check, and mounting onto /proc/self/fd/<fd> pins the verified
    # inode so a concurrent rename cannot redirect the mount — the same TOCTOU
    # class op_addswap closes with O_EXCL|O_NOFOLLOW. A symlinked *ancestor* is
    # caught by assert_mountpoint_safe above; the residual reboot-time `mount -a`
    # path re-walk is bounded by the `nofail` option ensure_nofail() added.
    parent = os.path.dirname(args.mountpoint) or "/"
    try:
        os.makedirs(parent, exist_ok=True)
        try:
            os.mkdir(args.mountpoint, 0o755)
        except FileExistsError:
            pass  # a pre-existing real directory is fine; O_NOFOLLOW checks it below
        fd = os.open(args.mountpoint, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    except OSError as exc:
        die(f"mountpoint {args.mountpoint!r} is not a real directory: {exc}")

    # Mount against the held inode, not the path string, so the mount cannot be
    # redirected by a symlink swap between the open above and the mount here.
    try:
        result = subprocess.run(
            [MOUNT, "-t", args.fstype, "-o", options, args.device, f"/proc/self/fd/{fd}"],
            check=False,
            stderr=subprocess.PIPE,
            pass_fds=(fd,),
        )
    finally:
        os.close(fd)
    if result.returncode != 0:
        die(f"mount failed: {result.stderr.decode(errors='replace').strip()}")

    # Persist to fstab only after the mount succeeds (no bad-line-then-rollback window).
    entry = f"{args.device}\t{args.mountpoint}\t{args.fstype}\t{options}\t0\t0\n"
    write_fstab(append_fstab_entry(lines, entry))


def op_unmount(args) -> None:
    if not valid_mountpoint(args.mountpoint):
        die(f"invalid or forbidden mountpoint {args.mountpoint!r}")
    # umount(8) canonicalizes its argument, so a symlinked mountpoint would let a
    # caller unmount an unrelated (possibly critical) filesystem — the same
    # symlink-follow class as op_mount (#155). Refuse a symlinked mountpoint and
    # any that resolves to a critical path. This deliberately does NOT use the
    # strict realpath==normpath rule op_mount applies, which would wrongly reject
    # a legitimate mount reached through a symlinked ancestor like /var/run -> /run.
    if os.path.islink(args.mountpoint):
        die(f"mountpoint {args.mountpoint!r} is a symlink; refusing to unmount through it")
    if os.path.realpath(args.mountpoint) in CRITICAL_MOUNTPOINTS:
        die(f"mountpoint {args.mountpoint!r} resolves to a critical path; refusing")
    # Unmount if currently mounted (ignore "not mounted").
    subprocess.run([UMOUNT, args.mountpoint], check=False, stderr=subprocess.DEVNULL)
    lines = read_fstab()
    kept = remove_fstab_lines(lines, fstab_field2, args.mountpoint)
    if len(kept) != len(lines):
        write_fstab(kept)


def op_addswap(args) -> None:
    path = args.file
    if not path.startswith("/") or ".." in path or not MOUNTPOINT_RE.match(path):
        die(f"invalid swap file path {path!r}")
    if args.size_mb < 1 or args.size_mb > 1_048_576:  # cap at 1 TiB
        die("size-mb out of range")
    # Create the file atomically, refusing to follow a symlink. `os.path.exists`
    # follows symlinks, so a *dangling* symlink read as absent, and the root `dd`
    # below then followed it to create an attacker-chosen file (e.g.
    # `/tmp/swapfile -> /etc/nologin`). O_EXCL|O_NOFOLLOW makes the create fail if
    # the path exists at all or is a symlink, which closes both the dangling-link
    # and the ordinary-clobber cases in one syscall, with no TOCTOU window.
    try:
        fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    except FileExistsError:
        # O_EXCL raises this for a symlink too (dangling or not), which is the
        # attack we are refusing, as well as an ordinary pre-existing file.
        die(f"{path} already exists")
    except OSError as exc:
        die(f"cannot create swap file {path!r}: {exc}")
    # Keep the fd and write through it, never re-opening by path. Re-opening
    # (even with dd conv=nocreat) leaves a window in which a local user who owns
    # the directory could unlink our file and drop a symlink in its place, and
    # root's write would then follow it. Writing to /proc/self/fd/<fd> targets the
    # exact inode we created, with no second name resolution.
    alloc = None
    try:
        # Real zeros via dd — a swap file must NOT be sparse (`swapon` refuses
        # files "with holes"), which rules out truncate/fallocate. conv=notrunc
        # because the fd already points at our 0-byte file; conv=nocreat because
        # the target already exists.
        # `pass_fds` keeps `fd` open across the fork so dd's own
        # `/proc/self/fd/<fd>` resolves to the inode we created. Without it,
        # `close_fds` (the default) would shut the fd and dd would fail.
        alloc = subprocess.run(
            [
                DD,
                "if=/dev/zero",
                f"of=/proc/self/fd/{fd}",
                "conv=nocreat,notrunc",
                "bs=1M",
                f"count={args.size_mb}",
            ],
            check=False,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.PIPE,
            pass_fds=(fd,),
        )
    finally:
        os.close(fd)
    if alloc.returncode != 0:
        try:
            os.unlink(path)
        except OSError:
            pass
        die(f"dd failed: {alloc.stderr.decode(errors='replace').strip()}")
    # No chmod: the file was created 0600 via O_CREAT, so re-opening it by path
    # here would only reintroduce a symlink-follow window for no gain.
    for cmd in ([MKSWAP, path], [SWAPON, path]):
        r = subprocess.run(cmd, check=False, stderr=subprocess.PIPE)
        if r.returncode != 0:
            subprocess.run([SWAPOFF, path], check=False, stderr=subprocess.DEVNULL)
            try:
                os.unlink(path)
            except OSError:
                pass
            die(f"{os.path.basename(cmd[0])} failed: {r.stderr.decode(errors='replace').strip()}")
    lines = read_fstab()
    if not any(fstab_field1(ln) == path for ln in lines):
        entry = f"{path}\tnone\tswap\tsw,nofail\t0\t0\n"
        write_fstab(append_fstab_entry(lines, entry))


def known_swap_files() -> set:
    """Absolute paths this host actually knows as swap FILES.

    Two sources, union: `/proc/swaps` rows whose Type is `file` (swap that is
    live right now) and `/etc/fstab` rows whose fstype is `swap` (swap the host
    is configured to have). Swap *partitions* are excluded from both — they are
    block devices, never something to unlink — as are commented-out fstab lines.
    """
    known = set()
    try:
        with open(PROC_SWAPS, "r") as fh:
            next(fh, None)  # header: Filename Type Size Used Priority
            for line in fh:
                fields = line.split()
                if len(fields) >= 2 and fields[1] == "file":
                    known.add(fields[0])
    except OSError:
        # No /proc/swaps (a container, a test harness): fstab alone decides.
        pass
    for line in read_fstab():
        if line.lstrip().startswith("#"):
            continue
        fields = line.split()
        if len(fields) >= 3 and fields[2] == "swap":
            known.add(fields[0])
    return known


def op_rmswap(args) -> None:
    path = args.file
    if not path.startswith("/") or ".." in path or not MOUNTPOINT_RE.match(path):
        die(f"invalid swap file path {path!r}")
    # A root unlink gated only by a charset check is an arbitrary-deletion
    # primitive. Every step between the check and the unlink tolerates a
    # non-swap path — swapoff runs with check=False, and the fstab rewrite is a
    # no-op when nothing matches — so `--file /etc/shadow` used to reach
    # os.unlink and delete the shadow file. Removal is confined to paths the
    # host itself reports as swap files.
    if path not in known_swap_files():
        die(f"{path!r} is not a known swap file (absent from {PROC_SWAPS} and {FSTAB})")
    # Even a declared path must not be a symlink: that would let whoever can
    # write an fstab line choose what root deletes, and `swapon` would never
    # have accepted the link as swap in the first place.
    if os.path.islink(path):
        die(f"{path!r} is a symlink, not a swap file; refusing to remove it")
    subprocess.run([SWAPOFF, path], check=False, stderr=subprocess.DEVNULL)
    lines = read_fstab()
    kept = remove_fstab_lines(lines, fstab_field1, path)
    if len(kept) != len(lines):
        write_fstab(kept)
    if os.path.exists(path):
        try:
            os.unlink(path)
        except OSError as exc:
            die(f"cannot remove swap file: {exc}")


def main() -> None:
    parser = argparse.ArgumentParser(description="Manage mounts/swap + /etc/fstab.")
    parser.add_argument("--op", required=True, choices=["mount", "unmount", "addswap", "rmswap"])
    parser.add_argument("--device")
    parser.add_argument("--mountpoint")
    parser.add_argument("--fstype")
    parser.add_argument("--options")
    parser.add_argument("--file")
    parser.add_argument("--size-mb", type=int, dest="size_mb")
    args = parser.parse_args()

    if args.op == "mount":
        if not (args.device and args.mountpoint and args.fstype):
            die("mount requires --device, --mountpoint, --fstype")
        op_mount(args)
    elif args.op == "unmount":
        if not args.mountpoint:
            die("unmount requires --mountpoint")
        op_unmount(args)
    elif args.op == "addswap":
        if not (args.file and args.size_mb):
            die("addswap requires --file and --size-mb")
        op_addswap(args)
    elif args.op == "rmswap":
        if not args.file:
            die("rmswap requires --file")
        op_rmswap(args)


if __name__ == "__main__":
    main()
