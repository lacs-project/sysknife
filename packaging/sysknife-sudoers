# sudoers fragment for the SysKnife privileged daemon.
#
# Deploy to: /etc/sudoers.d/sysknife
# Permissions: 0440  (sudo refuses files that are world-writable)
#
# These commands are not controllable via D-Bus / polkit and therefore
# require a direct sudo invocation by the daemon process.
#
# No shell or general runuser grant is permitted. Multi-step and user-scoped
# actions use independently validated, operation-restricted helpers. Other
# grants still cover powerful administrative tools: the daemon's authorization,
# validation and audit remain essential. See each grant's scope below.
#
# IMPORTANT: test with `visudo -cf /etc/sudoers.d/sysknife` before deploying.
#
# Note: `Defaults:sysknife !requiretty` was removed. Ubuntu 26.04 ships sudo-rs
# (0.2.x — the memory-safe Rust reimplementation, now the default; verified on a
# live 26.04 VM), which has no requiretty concept at all; on traditional sudo
# the token was dropped in 1.9.13. Either way the sysknife daemon runs as a
# non-interactive service, so no tty is involved.
#
# sudo-rs compatibility (verified 2026-07-22 on 26.04, sudo-rs 0.2.13):
# `visudo -cf` parses this file OK and every grant is honoured, including the
# trailing-`*` wildcard grants. sudo-rs permits `*` ONLY as the final argument
# (non-final wildcards like `find * -exec *` are rejected as a privesc vector) —
# which is the only wildcard form this file uses, so no grant needs reworking.

# User management — create and delete system/human accounts.
# useradd: called by CreateUser  (sudo useradd --create-home ...)
# userdel: called by DeleteUser  (sudo userdel <username>)
# `useradd --create-home` is the only form CreateUser builds, and every
# optional flag follows it (actions/users.rs::create_user). A bare grant also
# permitted `useradd -o -u 0 -g 0 backdoor`, a second uid-0 account, which is
# root without a shell grant. The leading literal is what forbids it.
sysknife ALL=(root) NOPASSWD: /usr/sbin/useradd --create-home *
sysknife ALL=(root) NOPASSWD: /usr/sbin/userdel

# Group membership — add/remove users to/from groups.
# usermod: called by AddUserToGroup  (sudo usermod --append --groups <grp> <user>)
# gpasswd: called by RemoveUserFromGroup  (sudo gpasswd --delete <user> <grp>)
# LockUserAccount and UnlockUserAccount are the only callers, and each builds
# exactly one flag. A bare grant also permitted `usermod -p <hash> root`,
# which rewrites root's password hash.
sysknife ALL=(root) NOPASSWD: /usr/sbin/usermod --lock *
sysknife ALL=(root) NOPASSWD: /usr/sbin/usermod --unlock *
sysknife ALL=(root) NOPASSWD: /usr/bin/gpasswd

# Group lifecycle — create/delete groups.
# groupadd: called by CreateGroup  (sudo groupadd [--system] <group>)
# groupdel: called by DeleteGroup  (sudo groupdel <group>)
# No groupmod grant: SysKnife has no group-modify action, so that binary is
# intentionally left ungranted per least privilege.
sysknife ALL=(root) NOPASSWD: /usr/sbin/groupadd
sysknife ALL=(root) NOPASSWD: /usr/sbin/groupdel

# Process control — SignalProcess sends an allowlisted signal to a pid.
# kill is not a shell-spawner (no GTFOBins escalation); the daemon validates
# pid >= 2 and the signal name before invoking it. (LockUserAccount /
# UnlockUserAccount reuse the /usr/sbin/usermod grant above — no new grant.)
# Also backs the action-timeout reaper (#142): when a sudo action's root child
# outlives the deadline, the daemon runs `sudo -n /usr/bin/kill -s <SIG> -- -<pgid>`
# to signal that action's own process group as root — no new grant needed.
# SignalProcess always builds the `-s <SIG>` form, and so does the
# action-timeout reaper (#142). Requiring the literal `-s` keeps a bare
# `kill -9 -1` off the grant.
sysknife ALL=(root) NOPASSWD: /usr/bin/kill -s *

# Service management — start, stop, restart, reload, enable, disable, mask, unmask,
# daemon-reload. All systemctl write operations require root on Fedora.
# One grant per subcommand the catalogue actually builds. A bare grant also
# permitted `systemctl link /path/evil.service` followed by `enable --now`,
# and `systemctl start debug-shell.service`, which the daemon's
# ROOT_SHELL_UNITS denylist refuses on its own path and cannot refuse here.
# Derived from actions/services.rs; tests/sudoers_grants_match_argv.rs fails
# if an action ever builds a subcommand that is not in this list.
sysknife ALL=(root) NOPASSWD: /usr/bin/systemctl daemon-reload
sysknife ALL=(root) NOPASSWD: /usr/bin/systemctl reboot
sysknife ALL=(root) NOPASSWD: /usr/bin/systemctl start *
sysknife ALL=(root) NOPASSWD: /usr/bin/systemctl stop *
sysknife ALL=(root) NOPASSWD: /usr/bin/systemctl restart *
sysknife ALL=(root) NOPASSWD: /usr/bin/systemctl reload *
sysknife ALL=(root) NOPASSWD: /usr/bin/systemctl enable *
sysknife ALL=(root) NOPASSWD: /usr/bin/systemctl disable *
sysknife ALL=(root) NOPASSWD: /usr/bin/systemctl mask *
sysknife ALL=(root) NOPASSWD: /usr/bin/systemctl unmask *
sysknife ALL=(root) NOPASSWD: /usr/bin/systemctl set-property *

# Identity configuration — hostname, timezone, locale, NTP all require root via
# hostnamectl/timedatectl/localectl (polkit "interactive auth" fails for system users).
sysknife ALL=(root) NOPASSWD: /usr/bin/hostnamectl set-hostname *
sysknife ALL=(root) NOPASSWD: /usr/bin/timedatectl set-ntp *
sysknife ALL=(root) NOPASSWD: /usr/bin/timedatectl set-timezone *
sysknife ALL=(root) NOPASSWD: /usr/bin/localectl set-locale *

# Network configuration — resolvectl dns requires root; firewall-cmd --permanent
# writes to /etc/firewalld/ which requires root.
sysknife ALL=(root) NOPASSWD: /usr/bin/resolvectl dns *

# Fixed read-only nftables probes; the reporter itself has NO sudo grant.
sysknife ALL=(root) NOPASSWD: /usr/sbin/nft list ruleset
sysknife ALL=(root) NOPASSWD: /usr/sbin/nft -j list ruleset

# nmcli — ConfigureWifi (`nmcli device wifi connect <ssid> [password <pw>]`) on
# Ubuntu Desktop, where NetworkManager owns the interfaces rather than netplan.
# Narrowed to the wifi-connect subcommand: a bare nmcli grant would also permit
# `nmcli connection modify` to rewrite any saved connection profile.
# Missing entirely until now, so ConfigureWifi failed at runtime with
# "a password is required" — caught by tests/sudoers_grants_match_argv.rs.
sysknife ALL=(root) NOPASSWD: /usr/bin/nmcli device wifi connect *

# OS deployment management — rpm-ostree upgrade/install/rollback/cleanup/rebase/kargs
# communicate with rpm-ostreed via D-Bus and require root authorization.
# rpm-ostree status/kargs (read-only) still work without root but sudo does not hurt.
# rpm scriptlets run as root, so a bare grant reached every rpm-ostree
# subcommand including ones that take a local package path.
sysknife ALL=(root) NOPASSWD: /usr/bin/rpm-ostree cleanup *
sysknife ALL=(root) NOPASSWD: /usr/bin/rpm-ostree install *
sysknife ALL=(root) NOPASSWD: /usr/bin/rpm-ostree kargs
sysknife ALL=(root) NOPASSWD: /usr/bin/rpm-ostree kargs *
sysknife ALL=(root) NOPASSWD: /usr/bin/rpm-ostree override *
sysknife ALL=(root) NOPASSWD: /usr/bin/rpm-ostree rebase *
sysknife ALL=(root) NOPASSWD: /usr/bin/rpm-ostree rollback
sysknife ALL=(root) NOPASSWD: /usr/bin/rpm-ostree uninstall *
sysknife ALL=(root) NOPASSWD: /usr/bin/rpm-ostree upgrade
sysknife ALL=(root) NOPASSWD: /usr/bin/rpm-ostree upgrade *
sysknife ALL=(root) NOPASSWD: /usr/bin/rpm-ostree status *

# OSTree admin operations — pin/unpin deployments require root filesystem access.
# only Pin/UnpinDeployment call ostree, and both go through `admin pin`.
sysknife ALL=(root) NOPASSWD: /usr/bin/ostree admin pin *

# Storage / LVM — ExtendLogicalVolume / CreateLogicalVolume / CreateLvSnapshot.
# lvextend/lvcreate rewrite VG metadata and require root. `lvextend -r` also
# spawns resize2fs/xfs_growfs itself (as root), so no separate resize grant is
# needed. GetLvmReport reads metadata via bare `lvs` (the daemon is already
# root) and needs no grant. vg/lv/snapshot names and sizes are validated
# upstream (validated_lvm_name / validated_lvm_size in actions/validate.rs).
sysknife ALL=(root) NOPASSWD: /usr/sbin/lvextend
sysknife ALL=(root) NOPASSWD: /usr/sbin/lvcreate

# Fixed multi-step operations. No generic exec, shell, runuser, path or environment
# argument is accepted. The helper checks exact argument counts and allowlists.
# User modes resolve the account and irreversibly drop groups/GID/UID before
# opening authorized_keys or executing a user-configurable tool; UID 0 is refused.
sysknife ALL=(root) NOPASSWD: /usr/lib/sysknife/action-steps firewall *
sysknife ALL=(root) NOPASSWD: /usr/lib/sysknife/action-steps group-add *
sysknife ALL=(root) NOPASSWD: /usr/lib/sysknife/action-steps group-remove *
sysknife ALL=(root) NOPASSWD: /usr/lib/sysknife/action-steps snap-install-hold *
sysknife ALL=(root) NOPASSWD: /usr/lib/sysknife/action-steps ssh-add *
sysknife ALL=(root) NOPASSWD: /usr/lib/sysknife/action-steps ssh-remove *
sysknife ALL=(root) NOPASSWD: /usr/lib/sysknife/action-steps flatpak *
sysknife ALL=(root) NOPASSWD: /usr/lib/sysknife/action-steps podman *
sysknife ALL=(root) NOPASSWD: /usr/lib/sysknife/action-steps toolbox *

# ─────────────────────────────────────────────────────────────────────────────
# Ubuntu / Debian-family binaries
# ─────────────────────────────────────────────────────────────────────────────

# `sudo env DEBIAN_FRONTEND=noninteractive NEEDRESTART_MODE=a /usr/bin/apt-get …`
# Apt actions wrap apt-get in env to set non-interactive flags past sudo's
# default env-stripping. The grant is restricted to the exact env-var prefix
# that apt.rs produces — no other env-var combinations or binaries are reachable.
# (Red-team HI1 fix: previously granted unrestricted /usr/bin/env NOPASSWD.)
sysknife ALL=(root) NOPASSWD: /usr/bin/env DEBIAN_FRONTEND=noninteractive NEEDRESTART_MODE=a /usr/bin/apt-get *

# Apt write operations:
#   apt-mark hold/unhold             → AptHold / AptUnhold
#   apt-get install/remove/purge/…   → ONLY via the env-wrapped grant above.
# No bare `/usr/bin/apt-get` grant: apt.rs always invokes apt-get through the
# `env DEBIAN_FRONTEND=… apt-get *` form, and a bare apt-get NOPASSWD grant is a
# GTFOBins root-shell escape (e.g. `apt-get -o APT::Update::Pre-Invoke=…`), so it
# is deliberately omitted.
sysknife ALL=(root) NOPASSWD: /usr/bin/apt-mark

# add-apt-repository — provided by software-properties-common.
# AddPpa / RemovePpa.
sysknife ALL=(root) NOPASSWD: /usr/bin/add-apt-repository

# apt-pin edit — SetAptPin/RemoveAptPin delegate to this root-owned helper,
# which validates the name (no dots), package glob, Pin expression, and
# priority ([-1,1000]) and writes /etc/apt/preferences.d/sysknife-<name>.
# GetAptPins reads via bare `apt-cache policy` (no root needed) and needs no
# grant. A bare editor/apt grant is NOT given.
sysknife ALL=(root) NOPASSWD: /usr/lib/sysknife/apt-pin-edit *

# log edit — ConfigureLogRotation/RemoveLogRotation and ConfigureRemoteSyslog/
# RemoveRemoteSyslog delegate to this root-owned helper, which validates inputs,
# writes /etc/logrotate.d/sysknife-<name> (checked with `logrotate -d`) or
# /etc/rsyslog.d/60-sysknife-forward.conf (checked with `rsyslogd -N1`), rolling
# back on rejection, and restarts rsyslog for forwarding. GetLogrotateStatus
# runs bare `logrotate -d` (dry-run) and needs no grant.
sysknife ALL=(root) NOPASSWD: /usr/lib/sysknife/log-edit *

# PAM password policy. SetPasswordAging runs `chage` directly (fully scoped by
# argv). SetPasswordPolicy/SetAccountLockout delegate to the root-owned pam-edit
# helper, which re-validates ranges and writes a pwquality drop-in or a
# marker-delimited block in /etc/security/faillock.conf. GetPasswordAging runs
# bare `chage -l` (read-only) and needs no grant. (pam_pwquality enforcement
# additionally needs libpam-pwquality installed + enabled in the auth stack.)
sysknife ALL=(root) NOPASSWD: /usr/bin/chage
sysknife ALL=(root) NOPASSWD: /usr/lib/sysknife/pam-edit *

# Snap write operations (install / remove / refresh / hold / revert).
# snaps install and run as root, so `snap ack` and `snap download` on
# attacker-supplied files were reachable through a bare grant.
sysknife ALL=(root) NOPASSWD: /usr/bin/snap install *
sysknife ALL=(root) NOPASSWD: /usr/bin/snap refresh *
sysknife ALL=(root) NOPASSWD: /usr/bin/snap remove *
sysknife ALL=(root) NOPASSWD: /usr/bin/snap revert *

# UFW firewall — every mutating subcommand requires root.
sysknife ALL=(root) NOPASSWD: /usr/sbin/ufw

# Netplan — apply/generate/set rewrite /etc/netplan/ + reload interfaces.
# Path varies between releases: /usr/sbin/netplan on jammy/noble, but the
# binary may also live at /usr/bin/netplan on some installs. Allow both.
# the same tool at the other packaged location.
sysknife ALL=(root) NOPASSWD: /usr/sbin/netplan apply
sysknife ALL=(root) NOPASSWD: /usr/sbin/netplan generate
sysknife ALL=(root) NOPASSWD: /usr/sbin/netplan set *
# apply and generate take no arguments at all; only `set` is parameterised.
sysknife ALL=(root) NOPASSWD: /usr/bin/netplan apply
sysknife ALL=(root) NOPASSWD: /usr/bin/netplan generate
sysknife ALL=(root) NOPASSWD: /usr/bin/netplan set *

# AppArmor — aa-status (apparmor base), aa-enforce/aa-complain (apparmor-utils).
sysknife ALL=(root) NOPASSWD: /usr/sbin/aa-status
sysknife ALL=(root) NOPASSWD: /usr/sbin/aa-enforce
sysknife ALL=(root) NOPASSWD: /usr/sbin/aa-complain

# fail2ban-client — Fail2banStatus (read-only) / BanIp / UnbanIp.
# `fail2ban-client set <jail> action ... actionban <cmd>` executes a command as
# root, and `restart`/`reload` reread config a bare grant also permitted.
sysknife ALL=(root) NOPASSWD: /usr/bin/fail2ban-client status
sysknife ALL=(root) NOPASSWD: /usr/bin/fail2ban-client status *
sysknife ALL=(root) NOPASSWD: /usr/bin/fail2ban-client set *

# fail2ban jail config — ConfigureFail2banJail delegates to this root-owned
# helper, which writes /etc/fail2ban/jail.d/sysknife-<name>.local, tests it with
# `fail2ban-client -t`, and reloads (rolling back on rejection). Requires the
# fail2ban package installed to test/reload; writes the override either way.
sysknife ALL=(root) NOPASSWD: /usr/lib/sysknife/fail2ban-jail-edit *

# auditd file-watch rules — AddAuditRule/RemoveAuditRule delegate to this helper,
# which writes /etc/audit/rules.d/sysknife-<key>.rules and loads via augenrules.
# GetAuditRules runs bare `auditctl -l` (read-only) and needs no grant.
sysknife ALL=(root) NOPASSWD: /usr/lib/sysknife/audit-edit *

# certbot / ACME — ObtainCertificate / RenewCertificates (mutating; write TLS
# material). GetCertificates runs bare `certbot certificates` (read-only). Path
# is the apt install location; a snap install lives at /snap/bin/certbot.
# certbot --pre-hook/--post-hook run an arbitrary command as root, so a bare
# grant was a root shell. Only the two subcommands the catalogue builds.
sysknife ALL=(root) NOPASSWD: /usr/bin/certbot certonly *
sysknife ALL=(root) NOPASSWD: /usr/bin/certbot renew

# Ubuntu Pro CLI — ProAttach / ProDetach (mutating). ProStatus is read-only and
# does not require root, but `pro` itself is allowed for symmetry.
# Ubuntu Pro subcommands the catalogue builds, and no others.
sysknife ALL=(root) NOPASSWD: /usr/bin/pro attach *
sysknife ALL=(root) NOPASSWD: /usr/bin/pro detach *
sysknife ALL=(root) NOPASSWD: /usr/bin/pro enable *
sysknife ALL=(root) NOPASSWD: /usr/bin/pro disable *
sysknife ALL=(root) NOPASSWD: /usr/bin/pro status *

# Canonical Livepatch — LivepatchStatus shells through sudo.
sysknife ALL=(root) NOPASSWD: /usr/bin/canonical-livepatch

# do-release-upgrade — UbuntuReleaseUpgrade.
# Long-running (20-45 min) and reboot-required; preview-profile carries the
# warning for operators.
sysknife ALL=(root) NOPASSWD: /usr/bin/do-release-upgrade

# GRUB karg edit — GrubSetKargs delegates to this root-owned helper script.
# The helper encapsulates the backup, in-place edit, and update-grub steps,
# eliminating the previous unconstrained grants for cp, python3, and
# update-grub (red-team findings HI2 and HI3).
sysknife ALL=(root) NOPASSWD: /usr/lib/sysknife/grub-kargs-edit *

# Unattended-upgrades edit — ConfigureUnattendedUpgrades delegates to this
# root-owned helper, which writes the fixed /etc/apt/apt.conf.d/20auto-upgrades
# content (no free-form input) and ensures the package is installed.
sysknife ALL=(root) NOPASSWD: /usr/lib/sysknife/unattended-upgrades-edit *

# sshd option edit — SetSshdOption delegates to this root-owned helper, which
# writes an allowlisted option to a /etc/ssh/sshd_config.d/ drop-in, validates
# with `sshd -t`, and reloads ssh (rolling back on failure). Allowlisted keys
# and values only — not an arbitrary sshd_config editor.
sysknife ALL=(root) NOPASSWD: /usr/lib/sysknife/sshd-option-edit *

# scheduled-job edit — CreateScheduledJob delegates to this root-owned helper,
# which validates the name/command/schedule (rejecting control characters and
# validating the OnCalendar expression with systemd-analyze), writes a
# service+timer unit pair, daemon-reloads, and enables+starts the timer.
sysknife ALL=(root) NOPASSWD: /usr/lib/sysknife/scheduled-job-edit *

# sysctl edit — SetSysctl delegates to this root-owned helper, which validates
# the key (dotted form, no injection) and value (numeric/token allowlist),
# applies it with `sysctl -w`, and persists a `key = value` line to
# /etc/sysctl.d/60-sysknife.conf. A bare `sysctl` grant is deliberately NOT
# given: `sysctl -p <file>` would let the daemon load an arbitrary attacker
# file, so only this narrow helper path is allowed. GetSysctl reads via bare
# `sysctl` (the daemon is root) and needs no grant.
sysknife ALL=(root) NOPASSWD: /usr/lib/sysknife/sysctl-edit *

# mount edit — AddMount/RemoveMount/AddSwap/RemoveSwap delegate to this
# root-owned helper, which validates the device/mountpoint/fstype/options
# (allowlisted fstypes, forbidden critical mountpoints), (un)mounts, manages
# swap files, and keeps /etc/fstab in sync — writing every managed entry with
# `nofail` so a bad device can never wedge the boot. GetMounts reads via bare
# `findmnt` and needs no grant. Bare mount/swapon grants are NOT given: they
# would let the daemon mount arbitrary sources over arbitrary paths.
sysknife ALL=(root) NOPASSWD: /usr/lib/sysknife/mount-edit *

# sudoers edit — GrantSudoAccess/RevokeSudoAccess delegate to this root-owned
# helper, which builds a scoped rule and validates it with `visudo -cf` on a
# temp file BEFORE atomically installing it to /etc/sudoers.d/sysknife-grant-*
# (0440). The drop-in name is charset-restricted (no dots/tildes, which sudo
# would silently ignore) and command paths must be absolute with no wildcards.
# GetSudoGrants reads via the bare helper (`--op list`; the daemon is root) and
# needs no grant. A bare `visudo`/editor grant is NOT given.
sysknife ALL=(root) NOPASSWD: /usr/lib/sysknife/sudoers-edit *
