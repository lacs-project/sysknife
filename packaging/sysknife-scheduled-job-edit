#!/usr/bin/env python3
# sysknife-scheduled-job-edit — create a recurring scheduled job as a systemd
# service+timer unit pair.
#
# Install to: /usr/lib/sysknife/scheduled-job-edit
# Mode:       0755
# Owner:      root:root
#
# Invoked exclusively by the sysknife-daemon via:
#   sudo /usr/lib/sysknife/scheduled-job-edit \
#        --name <name> --command <command> --schedule <OnCalendar>
#
# The sudoers entry grants NOPASSWD only on this exact helper path. All three
# inputs are re-validated here (defense-in-depth — the daemon validates them
# too):
#   - name: must match ^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$ (safe unit stem; no
#     path separators, dots, or `@` templating).
#   - command: no control characters (blocks unit-file directive injection via
#     newlines); `%` is escaped to `%%` so it is never read as a systemd
#     specifier. Written verbatim to ExecStart, which systemd argv-splits with
#     NO shell.
#   - schedule: validated semantically with `systemd-analyze calendar`.

import argparse
import os
import re
import subprocess
import sys

UNIT_DIR = "/etc/systemd/system"
UNIT_PREFIX = "sysknife-"
SYSTEMCTL = "/usr/bin/systemctl"
SYSTEMD_ANALYZE = "/usr/bin/systemd-analyze"
# systemd's system unit load path, highest precedence first (systemd.unit(5)).
# A file in UNIT_DIR overrides a unit of the same name further down, so a job
# whose stem matches a packaged unit would replace it with a root oneshot
# running the caller's command. The Makefile installs SysKnife's own units in
# /usr/lib/systemd/system, so `--name daemon` used to replace the daemon.
# /lib/systemd/system is listed for hosts where /lib is not merged into /usr.
UNIT_LOAD_PATH = (
    UNIT_DIR,
    "/run/systemd/system",
    "/usr/local/lib/systemd/system",
    "/usr/lib/systemd/system",
    "/lib/systemd/system",
)

# Every pattern below is applied with fullmatch(). With match(), `$` also
# matches just before a trailing newline, so `name\n` passed the charset and
# then missed every exact-membership check after it.
# tests/release/helper-anchoring.test.sh drives each helper with one.
NAME_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$")


def die(msg: str) -> None:
    print(f"sysknife-scheduled-job-edit: {msg}", file=sys.stderr)
    sys.exit(1)


def unit_paths(name: str) -> tuple[str, str]:
    stem = f"{UNIT_PREFIX}{name}"
    return (
        os.path.join(UNIT_DIR, f"{stem}.service"),
        os.path.join(UNIT_DIR, f"{stem}.timer"),
    )


def write_exclusive_unit(path: str, content: str) -> None:
    """Create one unit without ever truncating an existing path."""
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o644)
    try:
        with os.fdopen(fd, "w", encoding="utf-8", newline="\n") as fh:
            fh.write(content)
    except BaseException:
        # We own this inode because O_EXCL created it. Do not leave a partial
        # unit behind if writing/closing fails.
        try:
            os.unlink(path)
        except OSError:
            pass
        raise


def main() -> None:
    parser = argparse.ArgumentParser(description="Create a systemd timer job.")
    parser.add_argument("--name", required=True)
    parser.add_argument("--command", required=True)
    parser.add_argument("--schedule", required=True)
    args = parser.parse_args()

    if not NAME_RE.fullmatch(args.name):
        die(f"invalid job name {args.name!r}")
    if any(ord(c) < 0x20 or ord(c) == 0x7F for c in args.command):
        die("command contains control characters")
    if any(ord(c) < 0x20 or ord(c) == 0x7F for c in args.schedule):
        die("schedule contains control characters")

    # Semantic validation of the OnCalendar expression.
    result = subprocess.run(
        [SYSTEMD_ANALYZE, "calendar", args.schedule],
        check=False,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )
    if result.returncode != 0:
        die(f"invalid OnCalendar schedule {args.schedule!r}")

    # `%` would be read as a systemd specifier in ExecStart; escape it so the
    # command is taken literally.
    exec_start = args.command.replace("%", "%%")

    service_path, timer_path = unit_paths(args.name)
    timer_unit_name = os.path.basename(timer_path)

    # Refuse a job whose unit already exists anywhere systemd would load it
    # from. The unprefixed stem is ambiguous with jobs created by older
    # SysKnife releases, and the namespaced one may be a packaged unit. Leave
    # migration or removal to an explicit operator action. O_EXCL below still
    # closes the race in UNIT_DIR itself.
    for directory in UNIT_LOAD_PATH:
        for stem in (args.name, f"{UNIT_PREFIX}{args.name}"):
            for suffix in (".service", ".timer"):
                if os.path.lexists(os.path.join(directory, stem + suffix)):
                    die(
                        f"refusing scheduled job {args.name!r}: unit "
                        f"{stem}{suffix} already exists in {directory}"
                    )

    service_unit = (
        "[Unit]\n"
        f"Description=SysKnife scheduled job: {args.name}\n\n"
        "[Service]\n"
        "Type=oneshot\n"
        f"ExecStart={exec_start}\n"
    )
    timer_unit = (
        "[Unit]\n"
        f"Description=SysKnife timer for {args.name}\n\n"
        "[Timer]\n"
        f"OnCalendar={args.schedule}\n"
        "Persistent=true\n\n"
        "[Install]\n"
        "WantedBy=timers.target\n"
    )

    created_paths: list[str] = []
    try:
        write_exclusive_unit(service_path, service_unit)
        created_paths.append(service_path)
        write_exclusive_unit(timer_path, timer_unit)
        created_paths.append(timer_path)
    except FileExistsError as exc:
        for created_path in reversed(created_paths):
            try:
                os.unlink(created_path)
            except OSError:
                pass
        blocked_path = exc.filename or "<unknown>"
        die(f"refusing to overwrite existing unit {blocked_path}")
    except OSError as exc:
        for created_path in reversed(created_paths):
            try:
                os.unlink(created_path)
            except OSError:
                pass
        die(f"cannot create unit files: {exc}")

    if subprocess.run([SYSTEMCTL, "daemon-reload"], check=False).returncode != 0:
        die("systemctl daemon-reload failed")

    if (
        subprocess.run(
            [SYSTEMCTL, "enable", "--now", timer_unit_name], check=False
        ).returncode
        != 0
    ):
        die(f"failed to enable/start {timer_unit_name}")


if __name__ == "__main__":
    main()
