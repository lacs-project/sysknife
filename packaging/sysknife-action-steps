def apt_package(value, operation):
    """Mirrors validated_install_package and validated_unmodified_package.

    apt-get reads a trailing `-` on an operand as "remove this package", a
    trailing `+` as "install this package" and a trailing `^` as "install every
    package of this task", so `install pkg-` removes, `remove pkg+` installs and
    `install ubuntu-desktop^` installs a task. A trailing `+` stays legal for
    `install` (g++ and libstdc++6 are real packages); every other verb refuses it
    and takes the arch-qualified spelling, `g++:amd64`. `^` is in no package name.
    fullmatch, so a trailing newline is refused. Whether a name that contains `.`
    or `+` is an exact package name is apt's to decide, with APT_EXACT_NAMES.
    tests/release/action-steps.test.sh runs the daemon's own corpus,
    crates/sysknife-daemon/tests/data/apt-package-parity.txt, through this.
    """
    if (not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9+._:=~-]{0,127}", value)
            or value.endswith((".deb", ".rpm", "-"))
            or (operation != "install" and value.endswith("+"))):
        raise ValueError("invalid package name")
    return value


def apt_argv(values):
    """The apt-get argv for `apt <subcommand> [<package>]`, and nothing else.

    `env DEBIAN_FRONTEND=... NEEDRESTART_MODE=a /usr/bin/apt-get *` was a sudoers
    grant, and the trailing `*` took apt's own options: `apt-get -o
    APT::Update::Pre-Invoke::=<cmd> update` runs <cmd> as root, with no preview,
    no approval receipt and no audit row. sudoers cannot say "and no options", so
    the subcommands are an allowlist, no argument is ever an option, and the
    operand follows a literal `--`. apt-mark takes the same options as apt-get,
    so hold and unhold are built here too instead of keeping a grant on it.
    """
    if len(values) == 1 and values[0] in APT_BARE:
        return ["/usr/bin/apt-get", *APT_EXACT_NAMES, *APT_BARE[values[0]]]
    if len(values) == 2 and values[0] in APT_WITH_PACKAGE:
        verb, package = values[0], apt_package(values[1], values[0])
        if verb in ("hold", "unhold"):
            return ["/usr/bin/apt-mark", *APT_EXACT_NAMES, verb, "--", package]
        return ["/usr/bin/apt-get", *APT_EXACT_NAMES, verb, "-y", "--", package]
    raise ValueError("unsupported apt operation")


def capture(argv):
    """Run a read-only query with the helper's own environment; (exit status, stdout)."""
    done = subprocess.run(argv, capture_output=True, text=True, env=APT_ENV)
    return done.returncode, done.stdout


def exact_package(verb, package):
    """Refuse unless `package` names exactly one real package.

    Defence in depth behind APT_EXACT_NAMES, which is undocumented: should an apt
    stop honouring it, an operand like `linux-image.+` would again act on every
    package its regular expression matches. This asks the database instead, and
    compares the names it returns with the operand as strings, so it holds whatever
    apt would have done with the operand.

    `install` asks apt-cache, which knows the packages in the archive lists.
    `remove`, `purge`, `hold` and `unhold` ask dpkg-query, which knows the packages
    dpkg has a record of, and which treats `*`, `?` and `[` as globs; none of them
    passes the character class. `name:arch` is kept, `=version` is only for apt-cache.
    A name that is only a virtual package, or a package dpkg has never seen, is
    refused rather than guessed at.
    """
    name = re.split(r"[:=]", package, maxsplit=1)[0]
    if verb == "install":
        code, out = capture([APT_CACHE, "show", "--no-all-versions", "--", package])
        found = re.findall(r"(?m)^Package: (\S+)$", out)
    else:
        code, out = capture([DPKG_QUERY, "-W", "-f=${Package}\\n", "--", package.split("=", 1)[0]])
        found = out.split()
    if code != 0 or not found or any(f != name for f in found):
        raise ValueError("that is not exactly one existing package")


def rpm_package(value):
    """Mirrors validated_install_package, which every layering action applies.

    The rule is apt_package's for `install`: a leading letter or digit (no
    option), no `/` (no local path or URL), no `.rpm` or `.deb` suffix (no local
    file), no trailing `-`. rpm-ostree installs a local `.rpm` and runs its
    scriptlets as root in the next deployment, so a path is the whole risk.
    tests/release/action-steps.test.sh runs the daemon's corpus,
    crates/sysknife-daemon/tests/data/rpm-ostree-parity.txt, through this.
    """
    return apt_package(value, "install")


def rebase_ref(value):
    """Mirrors validated_rebase_ref: validated_safe_arg, no local source, no unverified image.

    A rebase target is an ostree `remote:ref` or a registry image. Split on `:`,
    no part may be a local image transport (`oci:/path`, `dir:/path`, ...), start
    with `.`, or start with `/` unless it is the `//` of `docker://`. `..` and
    `@/` (an ostree transport's repository path) are refused anywhere.
    """
    safe(value)
    previous = ""
    for part in value.split(":"):
        lower = part.lower()
        if (lower in LOCAL_IMAGE_TRANSPORTS or lower in UNVERIFIED_IMAGE_TRANSPORTS
                or part.startswith(".")
                or (part.startswith("/") and not (previous == "docker" and part.startswith("//")))):
            raise ValueError("a rebase target must be a remote ref or a registry image")
        previous = lower
    if ".." in value or "@/" in value:
        raise ValueError("a rebase target must be a remote ref or a registry image")
    return value


def karg_token(value):
    """Mirrors validated_kernel_arg_token: one boot-line token, no leading `-`.

    The boot line is split on whitespace, so a space, tab, newline or quote
    would carry a second, unscreened token behind the first.
    """
    if len(value) > 254 or not re.fullmatch(r"[A-Za-z0-9._:/+@=,][A-Za-z0-9._:/+@=,-]*", value):
        raise ValueError("invalid kernel argument")
    return value


def karg_normalized(value):
    """Lowercase, with `-` read as `_` in the key and never in the value.

    The kernel's parameq() (kernel/params.c) and systemd's
    proc_cmdline_key_streq() treat the two as one character in a parameter
    name. Mirrors normalized_kernel_arg in crates/sysknife-daemon/src/executor.rs.
    """
    key, eq, rest = value.lower().partition("=")
    return key.replace("-", "_") + eq + rest


def karg_append(value):
    """Mirrors validated_safe_kernel_arg: karg_token, then the allowlist."""
    key, eq, rest = karg_normalized(karg_token(value)).partition("=")
    if not (key in KARG_FLAGS + KARG_HARDENING_FLAGS if not eq
            else (rest and key in KARG_VALUE_KEYS)
            or (key in KARG_LIST_VALUES and all(v in KARG_LIST_VALUES[key] for v in rest.split(",")))
            or rest in KARG_HARDENING_VALUES.get(key, ())):
        raise ValueError("that kernel argument is not on the allowlist")
    return value


def karg_delete(value):
    """Mirrors validated_safe_kernel_arg_removal: an ordinary key or a known downgrade."""
    lower = karg_normalized(karg_token(value))
    key = lower.split("=", 1)[0]
    if not (lower in KARG_WEAKENING or key in KARG_FLAGS or key in KARG_VALUE_KEYS
            or key in KARG_LIST_VALUES):
        raise ValueError("refusing to delete a hardening or unknown kernel argument")
    return value


def rpm_ostree_argv(values):
    """The rpm-ostree argv for `rpm-ostree <verb> <operand>...`, and nothing else.

    `/usr/bin/rpm-ostree <subcommand> *` grants took rpm-ostree's own options and
    any operand: `kargs --append=init=/bin/sh`, `install /path/to/local.rpm`,
    `rebase <any image>`, `override replace <local rpm>`, as root with no
    preview, no approval receipt and no audit row. sudoers cannot say "and no
    options", so the verbs are an allowlist, every operand is validated, and the
    only options in the argv are the ones written here.
    """
    if not values or values[0] not in RPM_OSTREE_VERBS:
        raise ValueError("unsupported rpm-ostree operation")
    verb, operands = values[0], values[1:]
    if verb == "install" and operands:
        return [RPM_OSTREE, "install", "--idempotent", *map(rpm_package, operands)]
    if verb == "uninstall" and operands:
        return [RPM_OSTREE, "uninstall", *map(rpm_package, operands)]
    if verb == "replace" and len(operands) == 2:
        old, new = map(rpm_package, operands)
        return [RPM_OSTREE, "install", new, "--uninstall", old]
    if verb == "override-remove" and len(operands) == 1:
        return [RPM_OSTREE, "override", "remove", rpm_package(operands[0])]
    if verb == "rebase" and len(operands) == 1:
        return [RPM_OSTREE, "rebase", rebase_ref(operands[0])]
    if verb == "kargs" and len(operands) % 2 == 0:
        argv = [RPM_OSTREE, "kargs"]
        for op, token in zip(operands[::2], operands[1::2]):
            if op == "append":
                argv.append("--append=" + karg_append(token))
            elif op == "delete":
                argv.append("--delete=" + karg_delete(token))
            else:
                raise ValueError("invalid kernel argument operation")
        return argv
    raise ValueError("unsupported rpm-ostree operation or argument count")


def safe(value):
    if not re.fullmatch(r"[A-Za-z0-9._:/+@][A-Za-z0-9._:/+@-]{0,253}", value):
        raise ValueError("invalid argument")
    return value


def username(value):
    """Mirrors validated_username: no leading `-` or `.`, no `..` anywhere.

    Names reach /home/<name>/ paths, so `..` and a leading dot are traversal.
    """
    if (not re.fullmatch(r"[A-Za-z0-9_][A-Za-z0-9._-]{0,31}", value)
            or ".." in value):
        raise ValueError("invalid account name")
    return value


def public_key(value):
    types = ("ssh-rsa", "ssh-ed25519", "ssh-ed25519-sk", "ecdsa-sha2-nistp256",
             "ecdsa-sha2-nistp384", "ecdsa-sha2-nistp521",
             "sk-ssh-ed25519", "sk-ecdsa-sha2-nistp256")
    if (not value.startswith(types) or len(value) > 8192
            or any(ord(c) < 32 or ord(c) > 126 or c in "'|;`$\\&" for c in value)):
        raise ValueError("invalid public key")
    return value


def tool_argv(tool, args):
    """Accept only argv produced by the corresponding typed constructors."""
    if tool == "podman":
        if args == ["ps", "--all", "--format", "json"]:
            return ["/usr/bin/podman", *args]
        if len(args) == 4 and args[:2] == ["create", "--name"]:
            return ["/usr/bin/podman", "create", "--name", safe(args[2]), safe(args[3])]
        if len(args) == 2 and args[0] in ("start", "stop", "rm", "inspect"):
            return ["/usr/bin/podman", args[0], safe(args[1])]
    elif tool == "toolbox":
        if args == ["list"]:
            return ["/usr/bin/toolbox", "list"]
        if len(args) == 2 and args[0] == "rm":
            return ["/usr/bin/toolbox", "rm", safe(args[1])]
        if len(args) in (3, 5, 7) and args[:2] == ["create", "--container"]:
            result = ["/usr/bin/toolbox", "create", "--container", safe(args[2])]
            seen = set()
            for flag, value in zip(args[3::2], args[4::2]):
                if flag not in ("--release", "--image") or flag in seen:
                    raise ValueError("invalid toolbox option")
                seen.add(flag)
                result.extend([flag, safe(value)])
            return result
    elif tool == "flatpak":
        patterns = [
            (["install", "--user", "-y"], 2),
            (["uninstall", "--user", "-y"], 1),
            (["remotes", "--user", "--columns=name,url"], 0),
            (["remote-add", "--user", "--if-not-exists"], 2),
            (["remote-delete", "--user"], 1),
            (["list", "--user", "--app", "--columns=application,name,version,origin"], 0),
            (["update", "--user", "-y"], 0),
            (["update", "--user", "-y"], 1),
            (["info", "--user"], 1),
        ]
        for prefix, count in patterns:
            if args[:len(prefix)] == prefix and len(args) == len(prefix) + count:
                return ["/usr/bin/flatpak", *prefix, *(safe(v) for v in args[len(prefix):])]
    raise ValueError("unsupported user operation")


def drop_to_user(name):
    import pwd
    account = pwd.getpwnam(username(name))
    if account.pw_uid == 0 or not os.path.isabs(account.pw_dir):
        raise ValueError("user operations require a non-root account with an absolute home")
    # NSS lookup is the only home-related operation permitted before this point.
    os.initgroups(account.pw_name, account.pw_gid)
    os.setgid(account.pw_gid)
    os.setuid(account.pw_uid)
    if os.getuid() != account.pw_uid or os.geteuid() != account.pw_uid:
        raise PermissionError("failed to drop root credentials")
    os.environ.clear()
    os.environ.update(SYSTEM_ENV, HOME=account.pw_dir, USER=account.pw_name,
                      LOGNAME=account.pw_name, SHELL=account.pw_shell,
                      XDG_RUNTIME_DIR=f"/run/user/{account.pw_uid}",
                      DBUS_SESSION_BUS_ADDRESS=f"unix:path=/run/user/{account.pw_uid}/bus")
    os.umask(0o077)
    os.chdir(account.pw_dir)
    return account


def edit_key(path, key, add):
    import fcntl
    flags = os.O_RDWR | os.O_NOFOLLOW | os.O_NONBLOCK
    if add:
        flags |= os.O_CREAT
    fd = os.open(path, flags, 0o600)
    with os.fdopen(fd, "r+b") as stream:
        if not stat.S_ISREG(os.fstat(stream.fileno()).st_mode):
            raise ValueError("authorized_keys is not a regular file")
        fcntl.flock(stream, fcntl.LOCK_EX)
        original = stream.read(16 * 1024 * 1024 + 1)
        if len(original) > 16 * 1024 * 1024:
            raise ValueError("authorized_keys exceeds size limit")
        encoded = public_key(key).encode("ascii")
        # Whole lines, never regex: a key comment like .* is literal text.
        lines = original.splitlines(keepends=True)
        if add:
            if any(line.rstrip(b"\n") == encoded for line in lines):
                return
            updated = original + (b"\n" if original and not original.endswith(b"\n") else b"") + encoded + b"\n"
        else:
            updated = b"".join(line for line in lines if line.rstrip(b"\n") != encoded)
        if updated != original:
            stream.seek(0)
            stream.write(updated)
            stream.truncate()
            stream.flush()
            os.fsync(stream.fileno())


def ensure_local_group(group):
    import fcntl
    import grp
    entry = grp.getgrnam(username(group))
    # Preserve the Fedora Atomic /usr/lib/group -> /etc/group materialization.
    # A fixed root-owned path, a locked descriptor and no symlink following.
    fd = os.open("/etc/group", os.O_RDWR | os.O_NOFOLLOW)
    with os.fdopen(fd, "r+", encoding="utf-8") as stream:
        fcntl.flock(stream, fcntl.LOCK_EX)
        data = stream.read()
        if any(line.split(":", 1)[0] == group for line in data.splitlines()):
            return
        stream.seek(0, os.SEEK_END)
        if data and not data.endswith("\n"):
            stream.write("\n")
        stream.write(f"{entry.gr_name}:{entry.gr_passwd}:{entry.gr_gid}:{','.join(entry.gr_mem)}\n")
        stream.flush()
        os.fsync(stream.fileno())


def run(argv, env=SYSTEM_ENV):
    subprocess.run(argv, check=True, env=env)


def main(args):
    if not args:
        raise ValueError("operation required")
    op, *values = args
    if op == "firewall" and len(values) == 3:
        zone, service, verb = values
        if verb not in ("add-service", "remove-service"):
            raise ValueError("invalid firewall operation")
        first = ["/usr/bin/firewall-cmd", "--permanent", f"--zone={safe(zone)}", f"--{verb}={safe(service)}"]
        run(first)
        run(["/usr/bin/firewall-cmd", "--reload"])
    elif op == "snap-install-hold" and len(values) == 2:
        name, channel = map(safe, values)
        run(["/usr/bin/snap", "install", f"--channel={channel}", name])
        run(["/usr/bin/snap", "refresh", "--hold", name])
    elif op == "user-create" and 1 <= len(values) <= 5:
        # `useradd --create-home ... <name>` used to be its own sudoers grant,
        # `/usr/sbin/useradd --create-home *`. A trailing `*` in sudoers matches
        # across word boundaries, so it also authorised
        # `useradd --create-home -o -u 0 -g 0 backdoor`, a second uid-0 account,
        # which is the escape the narrowing was written to close. sudoers cannot
        # express "and no further options", so the grammar is enforced here.
        name = username(values[0])
        argv = ["/usr/sbin/useradd", "--create-home"]
        rest, seen = list(values[1:]), set()
        while rest:
            flag = rest.pop(0)
            if flag in seen or flag not in ("--home-dir", "--shell") or not rest:
                raise ValueError("invalid user option")
            seen.add(flag)
            value = rest.pop(0)
            argv.extend([flag, absolute_path(value) if flag == "--home-dir" else safe(value)])
        run([*argv, name])
    elif op in ("user-lock", "user-unlock") and len(values) == 1:
        # Same shape: `usermod --lock *` also admitted
        # `usermod --lock -o -u 0 <user>`, which makes an existing account uid 0.
        flag = "--lock" if op == "user-lock" else "--unlock"
        name = username(values[0])
        if name in CRITICAL_ACCOUNTS:
            raise ValueError("refusing to change the lock on a critical system account")
        run(["/usr/sbin/usermod", flag, name])
    elif op == "unit" and len(values) == 2:
        # `systemctl start *` put the unit name in the wildcard, so
        # `systemctl start debug-shell.service` matched: an unauthenticated root
        # shell on tty9, past the daemon's own denylist.
        verb, unit = values
        if verb not in ACTIVATING_VERBS and verb not in QUIESCING_VERBS:
            raise ValueError("invalid unit operation")
        unit = unit_name(unit)
        if verb in ACTIVATING_VERBS:
            activatable_unit(unit)
        if verb in STOPPING_VERBS:
            stoppable_unit(unit)
        run(["/usr/bin/systemctl", verb, unit])
    elif op == "signal" and len(values) == 2:
        # SignalProcess (`signal <SIG> <pid>`) and the action-timeout reaper
        # (`signal <SIG> -<pgid>`). os.kill, so there is no kill(1) argv left
        # for a caller to extend.
        name, target = values
        if name not in SIGNALS:
            raise ValueError("invalid signal")
        os.kill(kill_target(target), getattr(signal, "SIG" + name))
    elif op == "user-delete" and len(values) == 1:
        # The bare `userdel` grant admitted `userdel -R <dir> <name>`. A
        # `userdel -- *` grant would not have helped: shadow-utils scans argv
        # for -R/--root and -P/--prefix before getopt, past any `--`. groupadd,
        # groupdel and chage below share that scan (GHSA-8rx7-g2jg-5pxg).
        name = username(values[0])
        if name in CRITICAL_ACCOUNTS:
            raise ValueError("that account is protected")
        run(["/usr/sbin/userdel", name])
    elif op == "group-create" and values[:-1] in ([], ["--system"]) and values:
        # The bare `groupadd` grant admitted `groupadd -o -g 0 <name>`.
        run(["/usr/sbin/groupadd", *values[:-1], username(values[-1])])
    elif op == "group-delete" and len(values) == 1:
        group = username(values[0])
        if group in CRITICAL_GROUPS:
            raise ValueError("that group is protected")
        run(["/usr/sbin/groupdel", group])
    elif op == "password-aging" and len(values) in (3, 5, 7):
        # The bare `chage` grant admitted `-R <dir>` and `chage -E 0 root`, and
        # the day counts are option values sudoers cannot pin.
        name = username(values[0])
        argv, seen = ["/usr/bin/chage"], set()
        for flag, days in zip(values[1::2], values[2::2]):
            if (flag not in AGING_FLAGS or flag in seen
                    or not re.fullmatch(r"[0-9]{1,5}", days)):
                raise ValueError("invalid password-aging option")
            seen.add(flag)
            argv.extend([flag, days])
        run([*argv, name])
    elif op == "lv-extend" and len(values) == 3:
        # `lvextend --config global/fsadm_executable=<path>` named the program
        # `-r` runs as root, and the size sits mid-argv where sudoers cannot
        # pin it, so the LVM verbs build their own argv here.
        vg, lv, size = values
        run(["/usr/sbin/lvextend", "-L", lvm_size(size), "-r",
             f"{lvm_name(vg)}/{lvm_name(lv)}"])
    elif op == "lv-create" and len(values) == 3:
        vg, name, size = values
        run(["/usr/sbin/lvcreate", "-L", lvm_size(size), "-n", lvm_name(name), lvm_name(vg)])
    elif op == "lv-snapshot" and len(values) == 4:
        vg, origin, snapshot, size = values
        run(["/usr/sbin/lvcreate", "-s", "-L", lvm_size(size), "-n", lvm_name(snapshot),
             f"{lvm_name(vg)}/{lvm_name(origin)}"])
    elif op == "apt":
        argv = apt_argv(values)
        if len(values) == 2:
            exact_package(values[0], values[1])
        run(argv, env=APT_ENV)
    elif op == "rpm-ostree":
        run(rpm_ostree_argv(values))
    elif op in ("group-add", "group-remove") and len(values) == 2:
        name, group = map(username, values)
        ensure_local_group(group)
        if op == "group-add":
            run(["/usr/sbin/usermod", "--append", "--groups", group, name])
        else:
            run(["/usr/bin/gpasswd", "--delete", name, group])
    elif op in ("ssh-add", "ssh-remove") and len(values) == 2:
        name, key = values
        public_key(key)
        account = drop_to_user(name)
        # No stat/open/mkdir of this user-controlled path occurs as root.
        edit_key(os.path.join(account.pw_dir, ".ssh", "authorized_keys"), key, op == "ssh-add")
    elif op in ("flatpak", "podman", "toolbox") and len(values) >= 2:
        name, *parameters = values
        argv = tool_argv(op, parameters)
        drop_to_user(name)
        os.execve(argv[0], argv, dict(os.environ))
    else:
        raise ValueError("unsupported operation or argument count")


if __name__ == "__main__":
    try:
        main(sys.argv[1:])
    except subprocess.CalledProcessError as error:
        sys.exit(error.returncode if error.returncode > 0 else 1)
    except (ValueError, KeyError, OSError) as error:
        print(f"action-steps: {error}", file=sys.stderr)
        sys.exit(1)
