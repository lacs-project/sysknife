def unit_name(value):
    """Mirrors validated_unit_name: no slashes, no spaces, no leading dash."""
    if value.startswith("-") or not re.fullmatch(r"[A-Za-z0-9@._:-]+", value):
        raise ValueError("invalid unit name")
    return value


def bare_unit(unit):
    """Mirrors bare_unit_name: lowercase, no type suffix, no instance."""
    lower = unit.lower()
    bare = next((lower[: -len(s)] for s in UNIT_SUFFIXES if lower.endswith(s)), lower)
    return bare.split("@", 1)[0]


def activatable_unit(value):
    """Mirrors validated_activatable_unit: unit_name plus both denylists."""
    unit = unit_name(value)
    bare = bare_unit(unit)
    if bare in ROOT_SHELL_UNITS:
        raise ValueError("that unit hands out a root shell")
    if bare in POWER_STATE_UNITS:
        raise ValueError("that unit changes the power state")
    return unit


def stoppable_unit(value):
    """Mirrors validated_stoppable_unit: unit_name plus the protected list."""
    unit = unit_name(value)
    bare = bare_unit(unit)
    if bare in PROTECTED_UNITS or bare.startswith(PROTECTED_UNIT_PREFIXES):
        raise ValueError("that unit is protected from stop and restart")
    return unit


def absolute_path(value):
    """Mirrors validated_absolute_path: absolute, no `..`, narrow charset.

    `useradd --home-dir` is root creating a directory at a path the caller
    names, so a relative path or a `..` segment is the whole risk.
    """
    if not value.startswith("/") or ".." in value or len(value) > 256:
        raise ValueError("invalid path")
    if not re.fullmatch(r"[A-Za-z0-9/_.-]+", value):
        raise ValueError("invalid path")
    return value


# Mirrors validated_kill_signal in crates/sysknife-daemon/src/executor.rs.
SIGNALS = ("TERM", "KILL", "HUP", "INT")


def kill_target(value):
    """A pid, or a process group as `-<pgid>`, never -1, 0 or 1.

    `/usr/bin/kill -s *` was a direct grant, and `kill -s KILL -1` signals every
    process root can reach while `kill -s KILL 1` kills init. The daemon's
    `pid >= 2` check covers only the argv the daemon builds.
    """
    if not re.fullmatch(r"-?[1-9][0-9]{0,9}", value):
        raise ValueError("invalid pid")
    target = int(value)
    if not 2 <= abs(target) <= 2**31 - 1:
        raise ValueError("pid and pgid -1, 0 and 1 are refused")
    return target


