def lvm_size(value):
    """Mirrors validated_lvm_size: `[+]<digits>[.<digits>][kmgtp]`, no shrink."""
    if len(value) > 32 or not re.fullmatch(r"\+?[0-9]+(\.[0-9]+)?[kKmMgGtTpP]?", value):
        raise ValueError("invalid LVM size")
