#!/usr/bin/env python3
# sysknife-grub-kargs-edit — privileged GRUB kernel argument editor.
#
# Install to: /usr/lib/sysknife/grub-kargs-edit
# Mode:       0755
# Owner:      root:root
#
# This script is invoked exclusively by the sysknife-daemon via:
#   sudo /usr/lib/sysknife/grub-kargs-edit --append <kargs> --delete <kargs>
#
# The sudoers entry grants NOPASSWD only on this exact helper path, replacing
# the previous unconstrained grants for python3, cp, and update-grub
# (red-team findings HI1, HI2, HI3).
#
# Usage:
#   sysknife-grub-kargs-edit --append karg1,karg2 --delete karg3,karg4
#
# Both --append and --delete accept a comma-separated list. Either may be an
# empty string, but at least one must be non-empty (exit 2 otherwise).
#
# Behaviour:
#   1. Validates every karg token against the allowed-character pattern, and
#      rejects dangerous --append tokens (denylist mirrors the daemon).
#   2. Backs up /etc/default/grub to /etc/default/grub.sysknife.bak.
#   3. Edits GRUB_CMDLINE_LINUX_DEFAULT="..." in-place.
#   4. Calls /usr/sbin/update-grub. On failure, restores the backup and exits
#      non-zero so the daemon can surface the error.

import argparse
import re
import shutil
import subprocess
import sys

# ---------------------------------------------------------------------------
# Constants — must match the values in grub.rs
# ---------------------------------------------------------------------------

GRUB_DEFAULT = "/etc/default/grub"
GRUB_BACKUP = "/etc/default/grub.sysknife.bak"

# Defense-in-depth: each karg token is validated independently.
# Deliberately wider than validated_safe_arg in validate.rs: kernel
# arguments take the key=value form (module.sig_enforce=1), so '=' must be
# accepted here, while validated_safe_arg rejects it. '=' stays out of that
# validator because a comma or an '=' there would let a caller inject extra
# tokens into the comma-separated list this helper receives — see the
# charset-check comment at the GrubSetKargs branch in executor.rs. The
# daemon screens every token before invoking the helper, and the denylist
# below enforces the boot-security policy independently of it.
KARG_PATTERN = re.compile(r"^[A-Za-z0-9_.+@:/=-]+$")

# Defense-in-depth denylist — mirrors validated_safe_kernel_arg in executor.rs.
# The daemon already rejects these before invoking the helper, but the helper is
# directly sudo-invocable via the wildcard NOPASSWD grant, so it must enforce the
# same policy independently. Blocks args that bypass boot security (init=,
# selinux=0, enforcing=0, security=, module_blacklist=) or drop to a single-user
# root shell (bare single/s/1, or systemd.unit= pointing at emergency/rescue/
# single).
#
# systemd.debug_shell is the same root shell reached by a different name:
# systemd-debug-generator pulls debug-shell.service into the boot transaction
# and spawns a root shell on tty9 with no login, so screening only
# systemd.unit=debug-shell.service left the front door open. Underscore is the
# real spelling per systemd-debug-generator(8); the hyphen forms are listed so a
# near-miss cannot creep back, and rd.* covers the initrd-honoured variant.
DENY_APPEND_PREFIXES = (
    "init=", "selinux=0", "enforcing=0", "security=", "module_blacklist=",
    "systemd.debug_shell", "systemd.debug-shell",
    "rd.systemd.debug_shell", "rd.systemd.debug-shell",
)
# nosmap/nosmep disable SMAP/SMEP enforcement; they are in the executor's
# BLOCKED_EXACT and were missing here.
DENY_APPEND_EXACT = ("single", "s", "1", "nosmap", "nosmep")
DENY_UNIT_TARGETS = ("emergency", "rescue", "single")

# --delete is screened too. "Removing an arg is always safe" was the premise for
# leaving it open, and it inverts the risk: the dangerous move is removing a
# PROTECTIVE arg. Deleting `module.sig_enforce=1` reaches the same next-boot
# state as appending an unsigned-module loader, which DENY_APPEND already
# refuses — so an unscreened --delete handed back every guarantee --append buys.
# Mirrors validated_safe_kernel_arg_removal in executor.rs; the prefixes are the
# KSPP-recommended boot parameters plus the LSM selectors.
DENY_DELETE_PREFIXES = (
    "lockdown=", "module.sig_enforce=", "security=", "selinux=", "enforcing=",
    "apparmor=", "pti=", "mitigations=", "init_on_alloc=", "init_on_free=",
    "page_alloc.shuffle=", "randomize_kstack_offset=", "slub_debug=",
    "page_poison=", "vsyscall=", "debugfs=", "iommu=", "intel_iommu=",
    "amd_iommu=",
)
DENY_DELETE_EXACT = ("slab_nomerge", "nosmt", "kaslr")

# One list, read in both directions. Each of these IS the downgrade, which
# settles both screens at once:
#
#   --delete X  → ALLOWED. Removing the downgrade hardens the host. Without this
#                 escape hatch the delete screen collapses into "no deletions at
#                 all" and SysKnife could never undo `mitigations=off` on a host
#                 that already boots with it.
#   --append X  → REFUSED. Adding the downgrade weakens the next boot, and it is
#                 the exact end state the delete screen exists to protect.
#
# Deriving the append refusal from this set rather than retyping it is the whole
# point. The two screens were written separately and drifted: --delete knew
# about apparmor=, mitigations=, pti= and module.sig_enforce=, --append did not,
# so `--append apparmor=0` silently disabled Ubuntu's MAC on the next boot while
# `--delete apparmor=1` was correctly refused. A token added here now lands on
# both screens or neither.
WEAKENING_KARGS = (
    "selinux=0", "enforcing=0", "apparmor=0", "mitigations=off", "pti=off",
    "lockdown=none", "debugfs=on", "iommu=off", "intel_iommu=off",
    "module.sig_enforce=0", "init_on_alloc=0", "init_on_free=0",
    "randomize_kstack_offset=off", "page_alloc.shuffle=0", "nokaslr",
)

UPDATE_GRUB = "/usr/sbin/update-grub"


# ---------------------------------------------------------------------------
# Validation
# ---------------------------------------------------------------------------


def validate_kargs(tokens: list[str], label: str) -> None:
    """Raise SystemExit(1) if any token fails the allowlist check."""
    for tok in tokens:
        if not KARG_PATTERN.match(tok):
            print(
                f"sysknife-grub-kargs-edit: invalid {label} karg {tok!r} "
                "(only [A-Za-z0-9_.+@:/=-] allowed)",
                file=sys.stderr,
            )
            sys.exit(1)


def reject_dangerous_append(tokens: list[str]) -> None:
    """Raise SystemExit(1) if any --append token could compromise boot security."""
    for tok in tokens:
        lower = tok.lower()
        base = lower.split("=", 1)[0]
        unit_val = lower[len("systemd.unit="):] if lower.startswith("systemd.unit=") else ""
        blocked = (
            any(lower.startswith(p) for p in DENY_APPEND_PREFIXES)
            or lower in DENY_APPEND_EXACT
            or base in DENY_APPEND_EXACT
            or any(unit_val.startswith(u) for u in DENY_UNIT_TARGETS)
            # Adding a known downgrade is the end state the --delete screen
            # exists to prevent; see WEAKENING_KARGS.
            or lower in WEAKENING_KARGS
        )
        if blocked:
            print(
                f"sysknife-grub-kargs-edit: refusing dangerous --append karg {tok!r} "
                "(would bypass boot security or drop to a single-user root shell)",
                file=sys.stderr,
            )
            sys.exit(1)


def reject_dangerous_delete(tokens: list[str]) -> None:
    """Raise SystemExit(1) if removing any --delete token would weaken the boot."""
    for tok in tokens:
        lower = tok.lower()
        if lower in WEAKENING_KARGS:
            continue
        blocked = (
            any(lower.startswith(p) for p in DENY_DELETE_PREFIXES)
            or lower in DENY_DELETE_EXACT
        )
        if blocked:
            print(
                f"sysknife-grub-kargs-edit: refusing to --delete karg {tok!r} "
                "(it is a boot-security protection; removing it weakens the next boot)",
                file=sys.stderr,
            )
            sys.exit(1)


# ---------------------------------------------------------------------------
# GRUB file edit
# ---------------------------------------------------------------------------


def edit_grub_cmdline(lines: list[str], append: list[str], delete: list[str]) -> list[str]:
    """Return a new line list with GRUB_CMDLINE_LINUX_DEFAULT updated."""
    out = []
    for line in lines:
        if line.startswith("GRUB_CMDLINE_LINUX_DEFAULT="):
            m = re.match(r'^(GRUB_CMDLINE_LINUX_DEFAULT=")([^"]*)(".*)', line)
            if m:
                value = m.group(2).strip()
                for d in delete:
                    # Remove the exact token (word-boundary match).
                    escaped = re.escape(d)
                    value = re.sub(r"(?<!\S)" + escaped + r"(?!\S)\s*", "", value)
                value = value.strip()
                if append:
                    value = (value + " " + " ".join(append)).strip()
                line = f'GRUB_CMDLINE_LINUX_DEFAULT="{value}"\n'
        out.append(line)
    return out


# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------


def main() -> None:
    parser = argparse.ArgumentParser(
        description="Edit GRUB_CMDLINE_LINUX_DEFAULT in /etc/default/grub."
    )
    parser.add_argument(
        "--append",
        default="",
        help="Comma-separated kargs to add (may be empty).",
    )
    parser.add_argument(
        "--delete",
        default="",
        help="Comma-separated kargs to remove (may be empty).",
    )
    args = parser.parse_args()

    append_tokens = [t for t in args.append.split(",") if t]
    delete_tokens = [t for t in args.delete.split(",") if t]

    if not append_tokens and not delete_tokens:
        print(
            "sysknife-grub-kargs-edit: at least one of --append or --delete must be non-empty",
            file=sys.stderr,
        )
        sys.exit(2)

    validate_kargs(append_tokens, "--append")
    validate_kargs(delete_tokens, "--delete")
    reject_dangerous_append(append_tokens)
    reject_dangerous_delete(delete_tokens)

    # Read grub config.
    try:
        with open(GRUB_DEFAULT, "r") as fh:
            original_lines = fh.readlines()
    except OSError as exc:
        print(f"sysknife-grub-kargs-edit: cannot read {GRUB_DEFAULT}: {exc}", file=sys.stderr)
        sys.exit(1)

    # Back up the original.
    try:
        shutil.copy2(GRUB_DEFAULT, GRUB_BACKUP)
    except OSError as exc:
        print(f"sysknife-grub-kargs-edit: cannot write backup {GRUB_BACKUP}: {exc}", file=sys.stderr)
        sys.exit(1)

    # Apply edits.
    new_lines = edit_grub_cmdline(original_lines, append_tokens, delete_tokens)

    # Write updated config.
    try:
        with open(GRUB_DEFAULT, "w") as fh:
            fh.writelines(new_lines)
    except OSError as exc:
        print(f"sysknife-grub-kargs-edit: cannot write {GRUB_DEFAULT}: {exc}", file=sys.stderr)
        # Restore backup before exiting.
        try:
            shutil.copy2(GRUB_BACKUP, GRUB_DEFAULT)
        except OSError:
            pass
        sys.exit(1)

    # Regenerate GRUB config.
    result = subprocess.run([UPDATE_GRUB], check=False)
    if result.returncode != 0:
        print(
            f"sysknife-grub-kargs-edit: {UPDATE_GRUB} failed (exit {result.returncode}); "
            "restoring backup",
            file=sys.stderr,
        )
        try:
            shutil.copy2(GRUB_BACKUP, GRUB_DEFAULT)
        except OSError as exc:
            print(
                f"sysknife-grub-kargs-edit: WARNING: backup restore failed: {exc}",
                file=sys.stderr,
            )
        sys.exit(result.returncode)


if __name__ == "__main__":
    main()
