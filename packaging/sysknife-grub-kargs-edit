#!/usr/bin/env python3
# sysknife-grub-kargs-edit — privileged GRUB kernel argument editor.
#
# Install to: /usr/lib/sysknife/grub-kargs-edit
# Mode:       0755
# Owner:      root:root
#
# This script is invoked exclusively by the sysknife-daemon via:
#   sudo /usr/lib/sysknife/grub-kargs-edit --append <kargs> --delete <kargs>
#
# The sudoers entry grants NOPASSWD only on this exact helper path, replacing
# the previous unconstrained grants for python3, cp, and update-grub
# (red-team findings HI1, HI2, HI3).
#
# Usage:
#   sysknife-grub-kargs-edit --append karg1,karg2 --delete karg3,karg4
#
# Both --append and --delete accept a comma-separated list. Either may be an
# empty string, but at least one must be non-empty (exit 2 otherwise).
#
# Behaviour:
#   1. Validates every karg token against the allowed-character pattern, and
#      accepts only the kernel arguments on the allowlist below (the daemon's).
#   2. Backs up /etc/default/grub to /etc/default/grub.sysknife.bak.
#   3. Edits GRUB_CMDLINE_LINUX_DEFAULT="..." in-place.
#   4. Calls /usr/sbin/update-grub. On failure, restores the backup and exits
#      non-zero so the daemon can surface the error.

import argparse
import re
import shutil
import subprocess
import sys

# ---------------------------------------------------------------------------
# Constants — must match the values in grub.rs
# ---------------------------------------------------------------------------

GRUB_DEFAULT = "/etc/default/grub"
GRUB_BACKUP = "/etc/default/grub.sysknife.bak"

# Every pattern below is applied with fullmatch(). With match(), `$` also
# matches just before a trailing newline, so `name\n` passed the charset and
# then missed every exact-membership check after it.
# tests/release/helper-anchoring.test.sh drives each helper with one.

# Defense-in-depth: each karg token is validated independently.
# Deliberately wider than validated_safe_arg in validate.rs: kernel
# arguments take the key=value form (module.sig_enforce=1), so '=' must be
# accepted here, while validated_safe_arg rejects it. '=' stays out of that
# validator because a comma or an '=' there would let a caller inject extra
# tokens into the comma-separated list this helper receives — see the
# charset-check comment at the GrubSetKargs branch in executor.rs. The
# daemon screens every token before invoking the helper, and the allowlist
# below enforces the boot-security policy independently of it.
KARG_PATTERN = re.compile(r"^[A-Za-z0-9_.+@:/=-]+$")

# The kernel arguments that may be added, in normal form (see normalized()
# below): lowercase, `-` read as `_` in the key. Anything not named here is
# refused. Documentation/admin-guide/kernel-parameters.txt and
# kernel-command-line(7) describe each key. This is an allowlist because four
# review rounds of the denylists it replaced each found another spelling past
# them: a hyphen in the key, a kstrtobool prefix such as `mitigations=of`, a
# mitigation switch nobody had listed. One list, three copies:
# crates/sysknife-daemon/src/executor.rs, packaging/sysknife-grub-kargs-edit and
# packaging/sysknife-action-steps. tests/release/grub-kargs-edit.test.sh and
# tests/release/action-steps.test.sh compare them element by element.
#
# Ordinary switches with no value; removable.
KARG_FLAGS = ("quiet", "splash", "rhgb", "nomodeset", "nowatchdog", "threadirqs")
# Hardening switches with no value; added, never removed.
KARG_HARDENING_FLAGS = ("nosmt", "slab_nomerge")
# Ordinary keys that take any value of the one-token character set; removable.
KARG_VALUE_KEYS = (
    "console", "video", "loglevel", "hugepages", "hugepagesz",
    "default_hugepagesz", "nvme_core.default_ps_max_latency_us", "usbcore.autosuspend",
    "nvidia_drm.modeset", "nvidia_drm.fbdev", "i915.enable_psr",
    "amdgpu.dc", "acpi_backlight", "mem_sleep_default", "pcie_aspm", "transparent_hugepage",
    "zswap.enabled", "systemd.show_status", "plymouth.enable",
)
# Ordinary keys whose value is a comma-separated list, each element from the
# key's own set; removable. rd.driver.blacklist= keeps a driver from loading, so
# it takes GPU drivers only. resume= is not listed at all: at a device the caller
# controls it boots a crafted hibernation image.
KARG_LIST_VALUES = {
    "rd.driver.blacklist": ("nouveau", "nvidia", "nvidia_drm", "nvidia_modeset", "radeon",
                            "amdgpu", "i915"),
}
# Hardening keys with the only values that may be added; never removed.
KARG_HARDENING_VALUES = {
    "lockdown": ("integrity", "confidentiality"),
    "module.sig_enforce": ("1",),
    "intel_iommu": ("on",),
    "amd_iommu": ("force_isolation",),
    "init_on_alloc": ("1",),
    "init_on_free": ("1",),
    "page_alloc.shuffle": ("1",),
    "randomize_kstack_offset": ("on",),
    "mitigations": ("auto", "auto,nosmt"),
    "pti": ("on",),
    "vsyscall": ("none",),
    "debugfs": ("off",),
}
# Exact downgrades, in normal form. Removing one hardens the host, so it is
# allowed although its key is not an ordinary one; none of them can be added.
KARG_WEAKENING = (
    "selinux=0", "enforcing=0", "apparmor=0", "lockdown=none", "debugfs=on", "iommu=off",
    "intel_iommu=off", "nokaslr", "nopti", "nosmap", "nosmep", "nospectre_v1",
    "nospectre_v2", "nospec_store_bypass_disable", "nospectre_bhb", "single", "emergency",
    "rescue", "rd.break", "rd.shell", "systemd.debug_shell", "init=/bin/sh", "init=/bin/bash",
    "mitigations=off", "pti=off", "audit=0", "module.sig_enforce=0", "init_on_alloc=0",
    "init_on_free=0", "page_alloc.shuffle=0", "randomize_kstack_offset=off", "spectre_v2=off",
    "spec_store_bypass_disable=off", "mds=off", "tsx_async_abort=off", "mmio_stale_data=off",
    "retbleed=off", "srbds=off", "l1tf=off", "spectre_bhi=off", "gather_data_sampling=off",
    "reg_file_data_sampling=off",
)

UPDATE_GRUB = "/usr/sbin/update-grub"


# ---------------------------------------------------------------------------
# Validation
# ---------------------------------------------------------------------------


def validate_kargs(tokens: list[str], label: str) -> None:
    """Raise SystemExit(1) if any token fails the allowlist check."""
    for tok in tokens:
        if not KARG_PATTERN.fullmatch(tok):
            print(
                f"sysknife-grub-kargs-edit: invalid {label} karg {tok!r} "
                "(only [A-Za-z0-9_.+@:/=-] allowed)",
                file=sys.stderr,
            )
            sys.exit(1)


def normalized(tok: str) -> str:
    """Lowercase, with `-` read as `_` in the key and never in the value.

    The kernel's parameq() (kernel/params.c) and systemd's
    proc_cmdline_key_streq() treat the two as one character in a parameter
    name. Mirrors normalized_kernel_arg in crates/sysknife-daemon/src/executor.rs.
    """
    key, eq, rest = tok.lower().partition("=")
    return key.replace("-", "_") + eq + rest


def reject_dangerous_append(tokens: list[str]) -> None:
    """Raise SystemExit(1) unless every --append token is on the allowlist."""
    for tok in tokens:
        key, eq, rest = normalized(tok).partition("=")
        allowed = (key in KARG_FLAGS + KARG_HARDENING_FLAGS if not eq
                   else (rest and key in KARG_VALUE_KEYS)
                   or (key in KARG_LIST_VALUES
                       and all(v in KARG_LIST_VALUES[key] for v in rest.split(",")))
                   or rest in KARG_HARDENING_VALUES.get(key, ()))
        if not allowed:
            print(
                f"sysknife-grub-kargs-edit: refusing --append karg {tok!r} "
                "(it is not on the kernel-argument allowlist)",
                file=sys.stderr,
            )
            sys.exit(1)


def reject_dangerous_delete(tokens: list[str]) -> None:
    """Raise SystemExit(1) unless every --delete token is ordinary or a known downgrade."""
    for tok in tokens:
        lower = normalized(tok)
        key = lower.split("=", 1)[0]
        if not (lower in KARG_WEAKENING or key in KARG_FLAGS or key in KARG_VALUE_KEYS
                or key in KARG_LIST_VALUES):
            print(
                f"sysknife-grub-kargs-edit: refusing to --delete karg {tok!r} "
                "(it is a boot-security protection or not on the allowlist)",
                file=sys.stderr,
            )
            sys.exit(1)


# ---------------------------------------------------------------------------
# GRUB file edit
# ---------------------------------------------------------------------------


def edit_grub_cmdline(lines: list[str], append: list[str], delete: list[str]) -> list[str]:
    """Return a new line list with GRUB_CMDLINE_LINUX_DEFAULT updated."""
    out = []
    for line in lines:
        if line.startswith("GRUB_CMDLINE_LINUX_DEFAULT="):
            m = re.match(r'^(GRUB_CMDLINE_LINUX_DEFAULT=")([^"]*)(".*)', line)
            if m:
                value = m.group(2).strip()
                for d in delete:
                    # Remove the exact token (word-boundary match).
                    escaped = re.escape(d)
                    value = re.sub(r"(?<!\S)" + escaped + r"(?!\S)\s*", "", value)
                value = value.strip()
                if append:
                    value = (value + " " + " ".join(append)).strip()
                line = f'GRUB_CMDLINE_LINUX_DEFAULT="{value}"\n'
        out.append(line)
    return out


# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------


def main() -> None:
    parser = argparse.ArgumentParser(
        description="Edit GRUB_CMDLINE_LINUX_DEFAULT in /etc/default/grub."
    )
    parser.add_argument(
        "--append",
        default="",
        help="Comma-separated kargs to add (may be empty).",
    )
    parser.add_argument(
        "--delete",
        default="",
        help="Comma-separated kargs to remove (may be empty).",
    )
    args = parser.parse_args()

    append_tokens = [t for t in args.append.split(",") if t]
    delete_tokens = [t for t in args.delete.split(",") if t]

    if not append_tokens and not delete_tokens:
        print(
            "sysknife-grub-kargs-edit: at least one of --append or --delete must be non-empty",
            file=sys.stderr,
        )
        sys.exit(2)

    validate_kargs(append_tokens, "--append")
    validate_kargs(delete_tokens, "--delete")
    reject_dangerous_append(append_tokens)
    reject_dangerous_delete(delete_tokens)

    # Read grub config.
    try:
        with open(GRUB_DEFAULT, "r") as fh:
            original_lines = fh.readlines()
    except OSError as exc:
        print(f"sysknife-grub-kargs-edit: cannot read {GRUB_DEFAULT}: {exc}", file=sys.stderr)
        sys.exit(1)

    # Back up the original.
    try:
        shutil.copy2(GRUB_DEFAULT, GRUB_BACKUP)
    except OSError as exc:
        print(f"sysknife-grub-kargs-edit: cannot write backup {GRUB_BACKUP}: {exc}", file=sys.stderr)
        sys.exit(1)

    # Apply edits.
    new_lines = edit_grub_cmdline(original_lines, append_tokens, delete_tokens)

    # Write updated config.
    try:
        with open(GRUB_DEFAULT, "w") as fh:
            fh.writelines(new_lines)
    except OSError as exc:
        print(f"sysknife-grub-kargs-edit: cannot write {GRUB_DEFAULT}: {exc}", file=sys.stderr)
        # Restore backup before exiting.
        try:
            shutil.copy2(GRUB_BACKUP, GRUB_DEFAULT)
        except OSError:
            pass
        sys.exit(1)

    # Regenerate GRUB config.
    result = subprocess.run([UPDATE_GRUB], check=False)
    if result.returncode != 0:
        print(
            f"sysknife-grub-kargs-edit: {UPDATE_GRUB} failed (exit {result.returncode}); "
            "restoring backup",
            file=sys.stderr,
        )
        try:
            shutil.copy2(GRUB_BACKUP, GRUB_DEFAULT)
        except OSError as exc:
            print(
                f"sysknife-grub-kargs-edit: WARNING: backup restore failed: {exc}",
                file=sys.stderr,
            )
        sys.exit(result.returncode)


if __name__ == "__main__":
    main()
