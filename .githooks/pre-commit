#!/usr/bin/env bash
# Local CI gate (keeps GitHub Actions idle). Bypass with: git commit --no-verify
#
# These are the Rust checks the `rust` job in .github/workflows/ci.yml runs,
# copied verbatim so a green commit here means a green job there. The hook used
# to run only fmt + nextest, which let a broken intra-doc link (a doc comment
# pointing at a function the same commit deleted) pass locally and fail in CI.
# A local gate that is a subset of the remote one buys a false green, not speed.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

# First, and cheapest: a credential in a commit is in the history whether or not
# it is ever pushed, and rewriting published history is a far worse day than
# being stopped here.
echo "[pre-commit] scripts/check_no_secrets.sh --staged"
scripts/check_no_secrets.sh --staged

echo "[pre-commit] cargo fmt --all --check"
cargo fmt --all --check

echo "[pre-commit] cargo clippy --workspace --all-features --all-targets --locked"
cargo clippy --workspace --all-features --all-targets --locked -- -D warnings

echo "[pre-commit] cargo doc --no-deps --workspace --locked"
RUSTDOCFLAGS="-D warnings" cargo doc --no-deps --workspace --locked

# scripts/test_baseline.sh, not a bare `cargo nextest run` -- because that is
# what the CI job runs. It wraps the same nextest invocation and additionally
# fails when the test count drifts from tests/evidence/workspace-tests.json.
# Running nextest directly here made this hook a subset of CI after all: a commit
# that added tests without regenerating the baseline passed pre-commit and then
# failed at push, which is exactly the false green the header above warns about.
echo "[pre-commit] scripts/test_baseline.sh (cargo nextest run --workspace --locked)"
scripts/test_baseline.sh

echo "[pre-commit] OK"
